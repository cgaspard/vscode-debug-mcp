{
  "name": "vscode-debug-mcp",
  "displayName": "VS Code Debug MCP",
  "description": "MCP server exposing VS Code debugging, terminals, debug console, launch configurations, and tasks to AI assistants.",
  "version": "0.1.0",
  "publisher": "cgaspard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cgaspard/vscode-debug-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cgaspard/vscode-debug-mcp/issues"
  },
  "homepage": "https://github.com/cgaspard/vscode-debug-mcp#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Debuggers", "AI", "Other"],
  "keywords": ["mcp", "debug", "ai", "claude", "copilot"],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeDebugMcp.start",
        "title": "Debug MCP: Start Server"
      },
      {
        "command": "vscodeDebugMcp.stop",
        "title": "Debug MCP: Stop Server"
      },
      {
        "command": "vscodeDebugMcp.showInfo",
        "title": "Debug MCP: Show Connection Info"
      },
      {
        "command": "vscodeDebugMcp.copyUrl",
        "title": "Debug MCP: Copy Server URL"
      },
      {
        "command": "vscodeDebugMcp.configureClaudeCode",
        "title": "Debug MCP: Install Claude Code Support…",
        "category": "Debug MCP"
      },
      {
        "command": "vscodeDebugMcp.resetInstallPrompt",
        "title": "Debug MCP: Reset Install Prompt"
      }
    ],
    "configuration": {
      "title": "VS Code Debug MCP",
      "properties": {
        "vscodeDebugMcp.port": {
          "type": "number",
          "default": 6736,
          "description": "Port for the MCP Streamable HTTP server."
        },
        "vscodeDebugMcp.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host interface to bind the MCP server to."
        },
        "vscodeDebugMcp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the MCP server automatically when the extension activates."
        },
        "vscodeDebugMcp.terminalBufferLines": {
          "type": "number",
          "default": 2000,
          "description": "Maximum lines of output retained per captured terminal/debug-console."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.5"
  }
}
